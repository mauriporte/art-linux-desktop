    dstack = Gtk.Stack(transition_type=Gtk.StackTransitionType.CROSSFADE, transition_duration=120)
    remote.pack_start(chip_scroll, False, False, 0)
    remote.pack_start(dstack, True, True, 0)
    status = label("", "art-muted", 0.5)
    remote.pack_end(status, False, False, 0)

    def flash(msg):
        status.set_text(msg)
        GLib.timeout_add_seconds(4, lambda: status.set_text("") or False)

    def sender(d):
        """Returns press(k) for a device: k is a REMOTE_KEYS name, or a raw command for IR devices."""
        def done(res):
            if res is None:
                flash(f"{d['name']}: not reachable")
        if d["type"] == "atv":
            return lambda k: bg(lambda: ha.call("remote", "send_command",
                                                {"entity_id": d["entity"], "command": REMOTE_KEYS[k]}) or True, done)
        if d["type"] == "ir":
            def ir(k):
                data = {"entity_id": d["entity"], "command": k}
                if d["device"]:
                    data["device"] = d["device"]
                bg(lambda: ha.call("remote", "send_command", data) or True, done)
            return ir
        return lambda k: bg(lambda: jr_send(d["host"], {"type": "key", "key": JR_KEYS[k]}) or True, done)

    def ir_page(d):
        press = sender(d)
        box = card()
        grid = Gtk.FlowBox(selection_mode=Gtk.SelectionMode.NONE, min_children_per_line=2, max_children_per_line=3,
                           homogeneous=True, row_spacing=8, column_spacing=8)
        for lab, cmd in d["commands"]:
            b = Gtk.Button()
            bl = Gtk.Label(label=lab, wrap=True, max_width_chars=9, justify=Gtk.Justification.CENTER)
            b.add(bl)
            b.get_style_context().add_class("art-key")
            b.connect("clicked", lambda _b, c=cmd: press(c))
            grid.add(b)
        sc = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER)
        sc.add(grid)
        box.pack_start(sc, True, True, 0)
        return box

    def jr_page(d):
        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        if d["host"] in jr_store()["peers"]:
            outer.pack_start(face(d), False, False, 0)
            return outer
        box = card()
        box.pack_start(label(f"Pair with Joint Remote on {d['name']}", "art-title"), False, False, 0)
        box.pack_start(label("Tap Pair: a 6-digit code appears on the device. Type it here.", "art-muted"), False, False, 0)
        code = Gtk.Entry(placeholder_text="6-digit code", input_purpose=Gtk.InputPurpose.DIGITS, max_length=6)
        pair = Gtk.Button(label="Pair")
        pair.get_style_context().add_class("suggested-action")

        def start(*_):
            bg(lambda: jr_pair_start(d["host"]) or True,
               lambda r: flash("Code shown on " + d["name"]) if r else flash(f"{d['name']}: not reachable"))
            code.grab_focus()

        def finish(*_):
            c = code.get_text().strip()
            if len(c) != 6:
                return

            def ok(r):
                if r:
                    for ch in outer.get_children():
                        outer.remove(ch)
                    outer.pack_start(face(d), False, False, 0)
                    outer.show_all()
                    flash("Paired with " + d["name"])
                else:
                    flash("Pairing failed: tap Pair for a new code")
            bg(lambda: jr_pair_finish(d["host"], c) or True, ok)
        pair.connect("clicked", start)
        code.connect("activate", finish)
        box.pack_start(pair, False, False, 0)
        box.pack_start(code, False, False, 0)
        outer.pack_start(box, False, False, 0)
        return outer

