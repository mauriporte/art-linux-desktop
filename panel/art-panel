# Android TV key names for HA's remote.send_command (androidtv_remote integration)
REMOTE_KEYS = {"up": "DPAD_UP", "down": "DPAD_DOWN", "left": "DPAD_LEFT", "right": "DPAD_RIGHT",
               "ok": "DPAD_CENTER", "back": "BACK", "home": "HOME", "play": "MEDIA_PLAY_PAUSE",
               "vol_down": "VOLUME_DOWN", "mute": "VOLUME_MUTE", "vol_up": "VOLUME_UP"}


# Joint Remote key names (its Receiver), for the same buttons
JR_KEYS = {"up": "up", "down": "down", "left": "left", "right": "right", "ok": "center", "back": "back",
           "home": "home", "play": "play_pause", "vol_down": "volume_down", "mute": "mute", "vol_up": "volume_up",
           "recents": "recents", "next": "next", "previous": "previous"}


def flip():
    return importlib.machinery.SourceFileLoader("artflip", FLIP).load_module()


def load_devices(ha, path=REMOTES):
    c = configparser.ConfigParser()
    c.optionxform = str
    c.read(path)
    devs = []
    for name in c.sections():
        s = c[name]
        d = {"name": name, "type": s.get("type", "atv"), "entity": s.get("entity", ""), "device": s.get("device", ""),
             "host": s.get("host", "")}
        d["commands"] = [tuple(x.strip() for x in p.split("=", 1)) if "=" in p else (p.strip(), p.strip())
                         for p in s.get("commands", "").split(",") if p.strip()]
        devs.append(d)
    if not devs and ha.ok and ha.remote:
        devs.append({"name": "TV", "type": "atv", "entity": ha.remote, "device": "", "host": "", "commands": []})
    return [d for d in devs if d["type"] == "jr" or ha.ok]


# ---- Joint Remote client (protocol: joint-remote Receiver.kt / Auth.kt)
def jr_sign(secret, method, path, t, nonce, body):
    msg = f"{method}\n{path}\n{t}\n{nonce}\n{body}".encode()
    return base64.b64encode(hmac.new(secret, msg, hashlib.sha256).digest()).decode()


def jr_store():
    try:
        with open(JR_STORE) as f:
            st = json.load(f)
    except (OSError, ValueError):
        st = {}
    if "id" not in st:
        st["id"] = base64.urlsafe_b64encode(secrets.token_bytes(9)).decode()
    st.setdefault("peers", {})
    return st


def jr_save(st):
    fd = os.open(JR_STORE, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        json.dump(st, f)


def jr_post(host, path, body, headers=None):
    r = urllib.request.Request(f"http://{host}:{JR_PORT}{path}", data=body.encode(), method="POST",
                               headers={"Content-Type": "application/json", **(headers or {})})
    with urllib.request.urlopen(r, timeout=6) as f:
        return json.loads(f.read() or b"{}")


def jr_pair_start(host):
    jr_post(host, "/pair/start", "{}")


def jr_pair_finish(host, code):
    st = jr_store()
    mine = {"id": st["id"], "name": socket.gethostname(), "kind": "desktop", "code": code.strip()}
    j = jr_post(host, "/pair/finish", json.dumps(mine))
    st["peers"][host] = {"name": j.get("name", host), "secret": j["secret"]}
    jr_save(st)


def jr_send(host, cmd):
    st = jr_store()
    peer = st["peers"].get(host)
    if not peer:
        raise RuntimeError("not paired")
    body, t, nonce = json.dumps(cmd), int(time.time() * 1000), secrets.token_urlsafe(12)
    sig = jr_sign(base64.b64decode(peer["secret"]), "POST", "/cmd", t, nonce, body)
    jr_post(host, "/cmd", body, {"x-id": st["id"], "x-time": str(t), "x-nonce": nonce, "x-sig": sig})


class HA:
    def __init__(self, path=HA_CONF):
        c = configparser.ConfigParser()
        c.read(path)
        s = c["ha"] if c.has_section("ha") else {}
        self.url, self.token = s.get("url", "").rstrip("/"), s.get("token", "")
        self.music, self.remote = s.get("music", ""), s.get("remote", "")

    @property
    def ok(self):
        return bool(self.url and self.token)

    def _req(self, path, body=None):
        r = urllib.request.Request(self.url + path, data=None if body is None else json.dumps(body).encode(),
                                   headers={"Authorization": "Bearer " + self.token, "Content-Type": "application/json"})
        with urllib.request.urlopen(r, timeout=8) as f:
            return f.read()

    def state(self, entity):
        return json.loads(self._req("/api/states/" + entity))

    def call(self, domain, service, data):
        self._req(f"/api/services/{domain}/{service}", data)

    def image(self, rel):
        return self._req(rel) if rel.startswith("/") else urllib.request.urlopen(rel, timeout=8).read()


def selftest():
    import tempfile
    with tempfile.NamedTemporaryFile("w", suffix=".ini", delete=False) as f:
        f.write("[ha]\nurl = http://x:8123/\ntoken = t\nmusic = media_player.m\n")
    h = HA(f.name)
    os.unlink(f.name)
    assert h.ok and h.url == "http://x:8123" and h.music == "media_player.m" and h.remote == ""
    assert not HA("/nonexistent").ok
    assert set(REMOTE_KEYS.values()) >= {"DPAD_CENTER", "BACK", "HOME"}
    with tempfile.NamedTemporaryFile("w", suffix=".ini", delete=False) as f:
        f.write("[Sound bar]\ntype = ir\nentity = remote.x\ndevice = sb\ncommands = Power=power, Vol +=vol_up, mute\n"
                "[Tab]\ntype = jr\nhost = 10.0.0.5\n")
    devs = load_devices(h, f.name)
    os.unlink(f.name)
    assert [d["name"] for d in devs] == ["Sound bar", "Tab"]
    assert devs[0]["commands"] == [("Power", "power"), ("Vol +", "vol_up"), ("mute", "mute")]
    assert [d["type"] for d in load_devices(HA("/nonexistent"), "/nonexistent")] == []
    # same HMAC as Joint Remote's Auth.sign: base64(HmacSHA256(secret, "method\npath\ntime\nnonce\nbody"))
    sig = jr_sign(b"k" * 32, "POST", "/cmd", 1, "abcdefgh", "{}")
    assert sig == base64.b64encode(hmac.new(b"k" * 32, b"POST\n/cmd\n1\nabcdefgh\n{}", hashlib.sha256).digest()).decode()
    print("selftest ok")


def run(open_now):
