    def fetch_forecast():
        w = fl.load_conf()["weather"]
        q = urllib.parse.urlencode({"latitude": w["latitude"], "longitude": w["longitude"], "timezone": "auto",
                                    "current": "temperature_2m,weather_code,is_day",
                                    "hourly": "temperature_2m,weather_code", "forecast_hours": 7,
                                    "daily": "weather_code,temperature_2m_max,temperature_2m_min", "forecast_days": 5})
        d = fl.get_json("https://api.open-meteo.com/v1/forecast?" + q)
        d["city"] = w.get("city", "")
        return d

    def show_weather(d):
        if not d:
            w_city.set_label("Set a city")
            return False
        cur = d["current"]
        icon, text = fl.wmo(cur["weather_code"], cur["is_day"])
        w_icon.set_from_icon_name(icon + "-symbolic", Gtk.IconSize.DIALOG)
        w_temp.set_text(f"{round(cur['temperature_2m'])}°")
        w_text.set_text(text)
        w_city.set_label(d["city"] or "Set a city")
        for box in (hours, days):
            for ch in box.get_children():
                box.remove(ch)
        h = d["hourly"]
        for t, temp, code in list(zip(h["time"], h["temperature_2m"], h["weather_code"]))[1:7]:
            col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
            col.pack_start(label(t[11:13] + "h", "art-muted", 0.5), False, False, 0)
            col.pack_start(wicon(fl.wmo(code)[0], 24), False, False, 0)
            col.pack_start(label(f"{round(temp)}°", None, 0.5), False, False, 0)
            hours.pack_start(col, True, True, 0)
        dd = d["daily"]
        for t, code, hi, lo in zip(dd["time"], dd["weather_code"], dd["temperature_2m_max"], dd["temperature_2m_min"]):
            row = Gtk.Box(spacing=10)
            day = time.strftime("%a", time.strptime(t, "%Y-%m-%d"))
            row.pack_start(label(day, None), False, False, 0)
            row.pack_start(wicon(fl.wmo(code)[0], 24), False, False, 0)
            row.pack_start(label(fl.wmo(code)[1], "art-muted"), True, True, 0)
            row.pack_start(label(f"{round(lo)}° / {round(hi)}°", None, 1.0), False, False, 0)
            days.pack_start(row, False, False, 0)
        weather.show_all()
        return False

    def refresh_weather():
        if "latitude" in fl.load_conf()["weather"]:
            bg(fetch_forecast, show_weather)
        else:
            show_weather(None)
        return False

    # ---- Remote page: a device selector on top, one control page per device
    devices = load_devices(ha)
    remote = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
    chips = Gtk.Box(spacing=6)
    chips.get_style_context().add_class("art-chips")
    chip_scroll = Gtk.ScrolledWindow(vscrollbar_policy=Gtk.PolicyType.NEVER, hscrollbar_policy=Gtk.PolicyType.EXTERNAL)
    chip_scroll.add(chips)
