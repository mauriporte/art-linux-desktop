    def ask_text(d, send):
        modal["open"] = True
        dlg = Gtk.Dialog(title=f"Type for {d['name']}", transient_for=panel, modal=True)
        dlg.add_buttons("Cancel", Gtk.ResponseType.CANCEL, "Send", Gtk.ResponseType.OK)
        ent = Gtk.Entry(placeholder_text="Sent in one go to the focused field", activates_default=True)
        dlg.set_default_response(Gtk.ResponseType.OK)
        dlg.get_content_area().pack_start(ent, True, True, 12)
        dlg.show_all()
        r, t = dlg.run(), ent.get_text()
        dlg.destroy()
        modal["open"] = False
        panel.present()
        if r == Gtk.ResponseType.OK and t:
            send(t)

    def link_from_clipboard(then):
        def got(_c, t):
            m = re.search(r"https?://\S+", t or "")
            then(m.group(0)) if m else flash("No link on the clipboard")
        clip.request_text(got)

    def face(d):
        """Joint Remote's remote: round D-pad with OK, a ring of eight buttons, links underneath."""
        press = sender(d)
        jr = d["type"] == "jr"

        def done_msg(msg):
            return lambda r: flash(msg if r else f"{d['name']}: not reachable")
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        fx = Gtk.Fixed(halign=Gtk.Align.CENTER)
        fx.set_size_request(FACE, FACE)
        dp = int(FACE * 0.56)
        pad = Gtk.Fixed()
        pad.set_size_request(dp, dp)

        def disc(_w, cr):  # Gtk.Fixed draws no CSS background: paint the round pad ourselves
            cr.set_source_rgb(0x1c / 255, 0x1c / 255, 0x1e / 255)
            cr.arc(dp / 2, dp / 2, dp / 2, 0, 2 * math.pi)
            cr.fill()
            return False
        pad.connect("draw", disc)
        a = int(dp * 0.30)
        for icon, k, x, y in (("pan-up", "up", (dp - a) // 2, 0), ("pan-down", "down", (dp - a) // 2, dp - a),
                              ("pan-start", "left", 0, (dp - a) // 2), ("pan-end", "right", dp - a, (dp - a) // 2)):
            pad.put(round_button(icon, k, lambda k=k: press(k), a, "art-arrow"), x, y)
        o = int(dp * 0.38)
        okb = Gtk.Button(label="OK")
        okb.set_size_request(o, o)
        okb.get_style_context().add_class("art-okring")
        okb.connect("clicked", lambda *_: press("ok"))
        pad.put(okb, (dp - o) // 2, (dp - o) // 2)
        fx.put(pad, (FACE - dp) // 2, (FACE - dp) // 2)
        r = FACE / 2 - RING / 2 - 4
        keyboard = ("input-keyboard", "Type", lambda: ask_text(d, lambda t: bg(
            lambda: jr_send(d["host"], {"type": "text", "text": t}) or True, done_msg("Typed on " + d["name"]))))
        ring = {0: ("media-playback-start", "Play or pause", lambda: press("play")),
                45: ("audio-volume-high", "Volume up", lambda: press("vol_up")),
                90: ("media-skip-forward", "Next", lambda: press("next")),
                135: ("audio-volume-low", "Volume down, hold to mute", lambda: press("vol_down")),
                180: keyboard if jr else ("audio-volume-muted", "Mute", lambda: press("mute")),
                225: ("edit-undo", "Back", lambda: press("back")),
                270: ("media-skip-backward", "Previous", lambda: press("previous")),
                315: ("go-home", "Home", lambda: press("home"))}
        for deg, (icon, tip, cb) in ring.items():
            b = round_button(icon, tip, cb, RING)
            if deg == 135:
                lp = Gtk.GestureLongPress.new(b)
                lp.connect("pressed", lambda *_: press("mute"))
                b._lp = lp
            x = FACE / 2 + r * math.sin(math.radians(deg)) - RING / 2
            y = FACE / 2 - r * math.cos(math.radians(deg)) - RING / 2
            fx.put(b, int(x), int(y))
        box.pack_start(fx, False, False, 0)
        links = Gtk.Box(spacing=14, halign=Gtk.Align.CENTER)
        if jr:
            links.pack_start(round_button("insert-link", "Paste & send link", lambda: link_from_clipboard(
                lambda u: bg(lambda: jr_send(d["host"], {"type": "link", "url": u}) or True,
                             done_msg("Link copied on " + d["name"]))), RING), False, False, 0)
        else:
            links.pack_start(round_button("go-jump", "Paste & open on the TV", lambda: link_from_clipboard(
                lambda u: bg(lambda: ha.call("remote", "turn_on", {"entity_id": d["entity"], "activity": u}) or True,
                             done_msg("Opening on " + d["name"]))), RING), False, False, 0)
        box.pack_start(links, False, False, 0)
        return box

    chip_buttons = []
    for i, d in enumerate(devices):
        page = face(d) if d["type"] == "atv" else ir_page(d) if d["type"] == "ir" else jr_page(d)
        dstack.add_named(page, str(i))
        cb = Gtk.ToggleButton(label=d["name"])
        cb.get_style_context().add_class("art-chip")
        chip_buttons.append(cb)
        chips.pack_start(cb, False, False, 0)

    def pick(idx):
        dstack.set_visible_child_name(str(idx))
        for j, b in enumerate(chip_buttons):
            if b.get_active() != (j == idx):
                b.handler_block_by_func(on_chip)
                b.set_active(j == idx)
                b.handler_unblock_by_func(on_chip)

    def on_chip(b):
        pick(chip_buttons.index(b))
    for b in chip_buttons:
        b.connect("toggled", on_chip)
    if devices:
        pick(0)

    # ---- the panel window: pages in a stack, swipe or tap the nav to switch
    stack = Gtk.Stack(transition_type=Gtk.StackTransitionType.SLIDE_LEFT_RIGHT, transition_duration=220)
    pages = []
    if ha.ok and ha.music:
        pages.append(("music", "Music", "music-notes", music))
    pages.append(("weather", "Weather", "weather-few-clouds", weather))
    if devices:
        pages.append(("remote", "Remote", "television", remote))
    nav = Gtk.Box(homogeneous=True)
    nav.get_style_context().add_class("art-nav")
    radios = {}
    for pid, title, icon, w in pages:
        stack.add_titled(w, pid, title)
        rb = Gtk.ToggleButton(label=title)
        rb.connect("toggled", lambda b, p=pid: b.get_active() and stack.set_visible_child_name(p))
        radios[pid] = rb
        nav.pack_start(rb, True, True, 0)

    def sync_nav(*_):
        cur = stack.get_visible_child_name()
        for pid, rb in radios.items():
            rb.set_active(pid == cur)
    stack.connect("notify::visible-child-name", sync_nav)

    panel = Gtk.Window(type_hint=Gdk.WindowTypeHint.UTILITY, decorated=False, skip_taskbar_hint=True,
                       skip_pager_hint=True)
    panel.set_keep_above(True)
    panel.set_default_size(WIDTH, geo.height)
    panel.set_size_request(WIDTH, geo.height)
    panel.move(geo.x + geo.width - WIDTH, geo.y)
    panel.get_style_context().add_class("art-panel")
    # see-through like Joint Remote's own screen: the wallpaper shows between the cards and buttons (needs a compositor)
    rgba = scr.get_rgba_visual()
    if rgba and scr.is_composited():
        panel.set_visual(rgba)
        panel.set_app_paintable(True)

        def clear(_w, cr):
            cr.set_source_rgba(0, 0, 0, 0)
            cr.set_operator(0)  # CAIRO_OPERATOR_CLEAR
            cr.paint()
            cr.set_operator(2)  # back to OVER for the children
            return False
        panel.connect("draw", clear)
    body = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10, margin=14)
    head = Gtk.Box()
    head.pack_start(nav, True, True, 0)
    pin = Gtk.ToggleButton()
    pin.set_image(Gtk.Image.new_from_icon_name("view-pin-symbolic", Gtk.IconSize.BUTTON))
    pin.set_tooltip_text("Pin: keep the panel open and make room for it")
    pin.get_style_context().add_class("art-pin")
    head.pack_start(pin, False, False, 0)
    head.pack_start(icon_button("window-close", lambda: (pin.set_active(False), hide()), "flat", Gtk.IconSize.BUTTON),
                    False, False, 0)
    body.pack_start(head, False, False, 0)
    body.pack_start(stack, True, True, 0)
    evb = Gtk.EventBox()
    evb.add(body)
    panel.add(evb)

    # HA configured but no token yet: let the user paste it here, so it never travels anywhere else
    if ha.url and not ha.token:
        hc = card()
        hc.pack_start(label("Connect Home Assistant for Music and Remote", "art-muted"), False, False, 0)
        tok = Gtk.Entry(placeholder_text="Paste a long-lived access token", visibility=False)
        hc.pack_start(tok, False, False, 0)

        def save_token(*_):
            t = tok.get_text().strip()
            if not t:
                return
            c = configparser.ConfigParser()
            c.read(HA_CONF)
            c["ha"]["token"] = t
            fd = os.open(HA_CONF, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
            with os.fdopen(fd, "w") as f:
                c.write(f)
            os.execv(sys.executable, [sys.executable, os.path.realpath(__file__), "--open"])
        tok.connect("activate", save_token)
        weather.pack_end(hc, False, False, 0)

    swipe = Gtk.GestureSwipe.new(evb)
    swipe.set_touch_only(False)

    def swiped(g, vx, vy):
        if abs(vx) < 300 or abs(vx) < abs(vy):
            return
        names = [p[0] for p in pages]
        i = names.index(stack.get_visible_child_name())
        if vx > 0 and i == 0:
            if not pin.get_active():
                hide()  # swipe right on the first page closes the panel (unless pinned)
        elif 0 <= i + (1 if vx < 0 else -1) < len(names):
            stack.set_visible_child_name(names[i + (1 if vx < 0 else -1)])
    swipe.connect("swipe", swiped)
    panel._swipe = swipe  # keep the gesture alive

    timer = {"id": None}

    def poll():
        refresh_music()
        return True

    def show():
        tab.hide()
        panel.show_all()
        panel.move(geo.x + geo.width - panel.get_size()[0], geo.y)  # stay flush right even if content widened it
        panel.present()
        refresh_music()
        refresh_weather()
        timer["id"] = GLib.timeout_add_seconds(10, poll)  # gentle on Home Assistant

    def hide():
        panel.hide()
        if timer["id"]:
            GLib.source_remove(timer["id"])
            timer["id"] = None
        tab.show_all()
    panel.connect("delete-event", lambda *_: hide() or True)
    panel.connect("focus-out-event",
                  lambda *_: (not pin.get_active() and not pop.get_visible() and not modal["open"]) and hide() or False)

    def strut(on):
        """Reserve the right edge (like a dock) so maximised windows stop at the pinned panel."""
        xid = str(panel.get_window().get_xid())
        w = panel.get_size()[0]
        if on:
            for prop, val in (("_NET_WM_STRUT", f"0, {w}, 0, 0"),
                              ("_NET_WM_STRUT_PARTIAL", f"0, {w}, 0, 0, 0, 0, 0, {geo.height - 1}, 0, 0, 0, 0")):
                subprocess.run(["xprop", "-id", xid, "-f", prop, "32c", "-set", prop, val], check=False)
        else:
            for prop in ("_NET_WM_STRUT", "_NET_WM_STRUT_PARTIAL"):
                subprocess.run(["xprop", "-id", xid, "-remove", prop], check=False)

    def pinned(b):
        on = b.get_active()
        # only a dock may sit inside the space it reserves; the type can only change while unmapped
        was = panel.get_visible()
        panel.hide()
        panel.set_type_hint(Gdk.WindowTypeHint.DOCK if on else Gdk.WindowTypeHint.UTILITY)
        if on or was:
            show()
        panel.set_keep_above(not on)
        strut(on)
        c = configparser.ConfigParser()
        c["panel"] = {"pinned": str(on).lower()}
        with open(PANEL_CONF, "w") as f:
            c.write(f)
    pin.connect("toggled", pinned)

    # ---- the edge tab
    tab = Gtk.Window(type=Gtk.WindowType.POPUP)
    tab.set_default_size(14, 110)
    tab.move(geo.x + geo.width - 14, geo.y + (geo.height - 110) // 2)
    tb = Gtk.EventBox()
    tb.get_style_context().add_class("art-tab")
    tb.add_events(Gdk.EventMask.BUTTON_PRESS_MASK | Gdk.EventMask.TOUCH_MASK)
    tb.connect("button-press-event", lambda *_: show())
    tb.connect("touch-event", lambda w, e: e.type == Gdk.EventType.TOUCH_BEGIN and show())
    tab.add(tb)
    tab.set_app_paintable(True)
    tab.show_all()
    pc = configparser.ConfigParser()
    pc.read(PANEL_CONF)
    if open_now or pc.getboolean("panel", "pinned", fallback=False):
        show()
    if pc.getboolean("panel", "pinned", fallback=False):
        pin.set_active(True)
    Gtk.main()


if __name__ == "__main__":
    a = sys.argv[1:]
    if a[:1] == ["--selftest"]:
        selftest()
    else:
        run(a[:1] == ["--open"])
